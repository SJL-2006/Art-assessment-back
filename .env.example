# 复制为 .env 后按需修改（本地开发默认使用 SQLite，可不改）
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# 共享 MySQL：把 DB_ENGINE 设为 mysql 后，dev 模式也会连接 MySQL（三人连同一台）
DB_ENGINE=mysql
DB_NAME=art_eval
DB_USER=art_user
DB_PASSWORD=你的密码
DB_HOST=rm-xxxx.mysql.rds.aliyuncs.com
DB_PORT=3306

# 操作日志中间件开关
OPERATION_LOG_ENABLED=1
