# 复制为 .env 后按需修改（本地开发默认使用 SQLite，可不改）
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# 生产环境 MySQL（仅当 DJANGO_SETTINGS_MODULE=config.settings.prod 时生效）
DB_NAME=art_eval
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# 操作日志中间件开关
OPERATION_LOG_ENABLED=1

# Anthropic Claude API（留空则不调用 AI）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# 可选：自定义 API 端点（使用代理或第三方中转时设置）
# ANTHROPIC_BASE_URL=
